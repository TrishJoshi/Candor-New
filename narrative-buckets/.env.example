# Copy to .env and fill in. .env is git-ignored.
NVIDIA_API_KEY=
# Optional overrides (defaults shown)
NVIDIA_BASE_URL=https://containers.datacrunch.io/nemotron-3-5-super-vl-b300/v1
NVIDIA_MODEL=nemotron-3.5-super-vl
NVIDIA_RPM=40
# Nemotron 3.x reasons before answering; labels don't need it (1 = thinking off)
NVIDIA_DISABLE_THINKING=1

# Embeddings: gemini (default) or local (MiniLM, offline)
GEMINI_API_KEY=
EMBEDDING_BACKEND=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMS=768
